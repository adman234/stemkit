{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>adman234/renovate-config"
  ],
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Minor, patch, pin and digest updates merge automatically once unit-tests and docker pass",
